# Research Curator — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# HuggingFace API key for Apertus (AI query generation + result evaluation)
# Get yours at: https://huggingface.co/settings/tokens
VITE_APERTUS_API_KEY=

# Serper API key (only needed for local dev without the Cloudflare Worker proxy)
# Get yours at: https://serper.dev
VITE_SERPER_API_KEY=

# URL of your deployed Cloudflare Worker proxy (see worker/serper-proxy.js)
# Required in production to avoid CORS issues with the Serper API
VITE_SERPER_PROXY_URL=
